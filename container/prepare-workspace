#!/usr/bin/env bash
set -euo pipefail

source_root=/opt/elec3441/student-materials
target_root=/workspace

if [[ ! -d "$source_root" ]]; then
  echo "ELEC3441 student materials are missing from the image" >&2
  exit 1
fi

for collection in labs homeworks handouts; do
  target="$target_root/$collection"
  if [[ ! -d "$source_root/$collection" ]]; then
    echo "ELEC3441 $collection are missing from the image" >&2
    exit 1
  fi

  mkdir -p "$target"
  cp -a --update=none "$source_root/$collection/." "$target/"
done

if [[ ! -d "$target_root/labs" || ! -d "$target_root/homeworks" || ! -d "$target_root/handouts" ]]; then
  echo "ELEC3441 workspace preparation failed" >&2
  exit 1
fi
