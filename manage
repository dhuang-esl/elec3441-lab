#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
local_image=${ELEC3441_LOCAL_IMAGE:-elec3441-lab:local}
image_ref_file="$script_dir/image.ref"
container=elec3441-lab
workspace="$script_dir/student-materials"

if [[ -n "${ELEC3441_IMAGE:-}" ]]; then
  image=$ELEC3441_IMAGE
elif [[ -s "$image_ref_file" ]]; then
  read -r image < "$image_ref_file"
else
  image=$local_image
fi

case "${1:-}" in
  build)
    docker build --tag "$local_image" "$script_dir"
    echo "Built local image: $local_image"
    if [[ "$image" != "$local_image" ]]; then
      echo "Verify it with: ELEC3441_IMAGE=$local_image ./manage verify"
    fi
    ;;
  pull)
    docker pull "$image"
    ;;
  verify)
    docker run --rm \
      --mount "type=bind,source=$workspace,target=/workspace,readonly" \
      "$image" verify-setup
    ;;
  up)
    if docker container inspect "$container" >/dev/null 2>&1; then
      docker rm --force "$container" >/dev/null
    fi
    docker run --detach \
      --name "$container" \
      --publish 127.0.0.1:6080:6080 \
      --shm-size 1gb \
      --mount "type=bind,source=$workspace,target=/workspace" \
      "$image" >/dev/null
    echo "ELEC3441 GUI: http://localhost:6080/vnc.html?autoconnect=1&resize=scale"
    ;;
  stop)
    docker stop "$container" >/dev/null
    ;;
  shell)
    docker exec --interactive --tty "$container" bash
    ;;
  status)
    docker ps --all --filter "name=^/${container}$"
    ;;
  *)
    echo "Usage: ./manage {build|pull|verify|up|stop|shell|status}" >&2
    exit 2
    ;;
esac
